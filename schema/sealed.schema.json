{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArthurG-data/ygjson/schema/sealed.schema.json",
  "title": "ygjson sealed file",
  "description": "data/sealed/<set id>.json: the sealed products filed under one set.",
  "type": "object",
  "additionalProperties": false,
  "required": ["products"],
  "properties": {
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "set", "category", "name", "contentsStatus", "contents", "sources"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "The slug of the TCGplayer product name, -2 on collision."},
          "set": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "category": {"enum": ["booster_pack", "booster_box", "case", "display", "structure_deck", "starter_deck", "deck", "tin",
                                "mega_tin", "special_edition", "collectors_set", "bundle", "promo_pack", "accessory", "other"]},
          "name": {"type": "string", "minLength": 1},
          "releaseDate": {"type": "string", "format": "date"},
          "identifiers": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tcgplayerProductIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
              "ygojsonId": {"type": "string", "minLength": 1}
            }
          },
          "contentsStatus": {"enum": ["complete", "partial", "unknown"],
                             "description": "complete: every item and count is stated. partial: what is listed is right, but counts or items are missing. unknown: nothing is stated."},
          "contents": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sealed": {"type": "array", "description": "Other sealed products inside this one (a box holds packs).",
                         "items": {"type": "object", "additionalProperties": false, "required": ["product"],
                                   "properties": {"product": {"type": "string"}, "count": {"type": "integer", "minimum": 1}}}},
              "pool": {"type": "array", "description": "Sets the product's cards are drawn from at random (a booster pack).",
                       "items": {"type": "object", "additionalProperties": false, "required": ["set"],
                                 "properties": {"set": {"type": "string"},
                                                "editions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["first", "unlimited", "limited"]}}}}},
              "cards": {"type": "array", "description": "Prints the product holds for certain (a structure deck).",
                        "items": {"type": "object", "additionalProperties": false, "required": ["print"],
                                  "properties": {"print": {"type": "string"}, "count": {"type": "integer", "minimum": 1}}}}
            }
          },
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}}
        }
      }
    }
  }
}
