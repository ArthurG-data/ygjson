{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArthurG-data/ygjson/schema/formats.schema.json",
  "title": "ygjson formats",
  "description": "legality/formats.json: the formats a legality event can name, each with the page its list is published on.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formats"],
  "properties": {
    "formats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "source"],
        "properties": {
          "id": {"enum": ["tcg", "ocg", "speed_duel", "goat"], "description": "The format id legality events name (legality.schema.json lists the same)."},
          "name": {"type": "string", "minLength": 1},
          "source": {"type": "string", "format": "uri"}
        }
      }
    }
  }
}
