{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArthurG-data/ygjson/schema/cards.schema.json",
  "title": "ygjson card file",
  "description": "data/cards/<bucket>.json: the cards whose id divided by 1,000,000 (floor, three digits) is <bucket>, each with every print of it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["cards"],
  "properties": {
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "names", "kind", "frame", "hasEffect", "isTuner", "identifiers", "prints"],
        "properties": {
          "id": {"type": "string", "pattern": "^[0-9]+$", "description": "YGOPRODeck's card id."},
          "passcode": {"type": "integer", "minimum": 0, "description": "The 8-digit number printed on the card. Absent for cards without one: YGOPRODeck's own ids for those are 100,000,000 and up."},
          "konamiId": {"type": "integer", "description": "The card's id on Konami's card database."},
          "name": {"type": "string", "minLength": 1, "description": "The English name; equals names.en."},
          "names": {"type": "object", "required": ["en"], "propertyNames": {"pattern": "^[a-z]{2}(-[A-Za-z]+)?$"},
                    "additionalProperties": {"type": "string", "minLength": 1}, "description": "The card's name by language code."},
          "kind": {"enum": ["monster", "spell", "trap", "token", "skill"]},
          "frame": {"enum": ["normal", "effect", "ritual", "fusion", "synchro", "xyz", "link", "normal_pendulum", "effect_pendulum",
                             "ritual_pendulum", "fusion_pendulum", "synchro_pendulum", "xyz_pendulum", "spell", "trap", "token", "skill"],
                    "description": "YGOPRODeck's frameType."},
          "attribute": {"enum": ["dark", "divine", "earth", "fire", "light", "water", "wind"], "description": "Monsters only."},
          "monsterType": {"type": "string", "minLength": 1, "description": "YGOPRODeck's race: the monster type (Dragon), or the spell or trap subtype (Quick-Play, Continuous)."},
          "level": {"type": "integer", "minimum": 0, "description": "Monsters that have a level. Xyz monsters have a rank instead."},
          "rank": {"type": "integer", "minimum": 0, "description": "Xyz monsters (frames xyz and xyz_pendulum). YGOPRODeck reports it as level."},
          "linkRating": {"type": "integer", "minimum": 1},
          "linkArrows": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "description": "YGOPRODeck's linkmarkers (Top, Bottom-Left...)."},
          "scale": {"type": "integer", "minimum": 0, "description": "Pendulum scale."},
          "atk": {"type": "integer", "minimum": 0, "description": "Absent when the card prints ?."},
          "def": {"type": "integer", "minimum": 0, "description": "Absent when the card prints ? and on Link monsters."},
          "hasEffect": {"type": "boolean"},
          "isTuner": {"type": "boolean"},
          "typeline": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "The type line's tokens in order (Cyberse, Link, Effect)."},
          "archetypes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}, "description": "Archetype slugs (data/archetypes.json)."},
          "tcgDate": {"type": "string", "format": "date", "description": "The card's first TCG release, per YGOPRODeck."},
          "ocgDate": {"type": "string", "format": "date"},
          "images": {"type": "array", "description": "Links to YGOPRODeck's images; none is copied. One entry per artwork.",
                     "items": {"type": "object", "additionalProperties": false, "required": ["id", "card"],
                               "properties": {"id": {"type": "integer"},
                                              "card": {"type": "string", "format": "uri", "description": "The full card image."},
                                              "small": {"type": "string", "format": "uri"},
                                              "art": {"type": "string", "format": "uri", "description": "The artwork alone, cropped."}}}},
          "identifiers": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ygoprodeckId"],
            "properties": {
              "ygoprodeckId": {"type": "integer"},
              "konamiId": {"type": "integer"},
              "ygojsonId": {"type": "string", "minLength": 1},
              "yugipediaIds": {"type": "array", "uniqueItems": true, "items": {"type": "integer"}}
            }
          },
          "aliases": {"type": "array", "uniqueItems": true, "minItems": 1, "items": {"type": "string", "minLength": 1},
                      "description": "Other English names shops sell this card under: YGOPRODeck's beta name (Red-Eyes B. Dragon) and TCGplayer's product name at one of its prints. Never another card's name."},
          "prints": {"type": "array", "items": {"$ref": "#/$defs/print"}}
        }
      }
    }
  },
  "$defs": {
    "print": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "set", "rarity"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+:[0-9]+:[A-Za-z0-9-]*:[a-z0-9_]+(:[a-z0-9-]+)?$",
               "description": "<set id>:<card id>:<set number or empty>:<rarity code>[:<variant>]. The same card in the same set at a different rarity is another print, and so is a version with its own TCGplayer product."},
        "variant": {"type": "string", "pattern": "^[a-z0-9-]+$",
                    "description": "A version of the print that shares its number and rarity and has its own TCGplayer product: a foil colour (blue), an art letter (b) or a numbered art (version-1). The print without one is the unmarked product."},
        "source": {"enum": ["tcgplayer"],
                   "description": "Present on a print YGOPRODeck does not list: minted from a TCGplayer product."},
        "set": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "number": {"type": "string", "minLength": 1, "description": "The set number printed on the card (LOB-EN005). Absent on the few prints YGOPRODeck gives none."},
        "region": {"type": "string", "pattern": "^[A-Z]+$", "description": "The letters between the prefix and the digits of the number (EN, E, PT). Absent when the number has none (LOB-001)."},
        "rarity": {"enum": [
          "10000_secret_rare", "collectors_rare", "common", "dt_normal_parallel", "dt_rare_parallel",
          "dt_secret_parallel", "dt_super_parallel", "dt_ultra_parallel", "extra_secret_rare",
          "ghost_gold_rare", "ghost_rare", "gold_rare", "gold_secret_rare", "grand_master_rare",
          "millennium_gold_rare", "millennium_rare", "millennium_secret", "millennium_super",
          "millennium_ultra", "mosaic_rare", "normal_parallel_rare", "pharaohs_rare", "platinum_rare",
          "platinum_secret_rare", "premium_gold_rare", "prismatic_secret", "qc_secret_rare", "rare",
          "secret_parallel_rare", "secret_rare", "shatterfoil_rare", "short_print", "starfoil_rare",
          "starlight_rare", "super_parallel_rare", "super_rare", "super_short_print", "ultimate_rare",
          "ultra_parallel_rare", "ultra_rare", "ultra_secret_rare", "unknown"],
          "description": "A code from tools/rarities.py."},
        "rawRarity": {"type": "string", "minLength": 1, "description": "The source's rarity string, kept when it mapped to unknown."},
        "editions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["first", "unlimited", "limited"]},
                     "description": "Present only when it differs from the set's editions."},
        "identifiers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tcgplayerProductIds": {"type": "array", "uniqueItems": true, "minItems": 1, "items": {"type": "integer"},
                                    "description": "One TCGplayer product serves every edition of a print; the edition is a price subtype."}
          }
        },
        "tcgplayer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "match"],
          "description": "How the TCGplayer product was tied to this print: its name there, and the rule that matched it.",
          "properties": {"name": {"type": "string"}, "match": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
